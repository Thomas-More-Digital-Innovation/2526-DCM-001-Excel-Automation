N8N_JWT_SECRET=change_this_to_a_random_32char_string

AKENEO_BASE_URL=https://your-akeneo.cloud.akeneo.com
AKENEO_CLIENT_ID=your_client_id_here
AKENEO_CLIENT_SECRET=your_client_secret_here
AKENEO_USERNAME=your_akeneo_username
AKENEO_PASSWORD=your_akeneo_password
OPENAI_API_KEY=sk-proj-...

# Postgres for saved column mappings
POSTGRES_USER=dcm
POSTGRES_PASSWORD=change_this
POSTGRES_DB=dcm
# Used by the CLI (scripts/enrich.js); n8n gets its own URL from docker-compose
MAPPINGS_DB_URL=postgres://dcm:change_this@localhost:5432/dcm
